{
  "name": "cc-model-switcher",
  "private": true,
  "version": "1.0.0",
  "description": "桌面端：管理和切换 Claude Code 的模型配置",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.cjs\"",
    "dev:web": "vite",
    "build": "vite build",
    "package": "node scripts/package.cjs",
    "package:raw": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.local.cc-model-switcher",
    "productName": "CC模型配置切换",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
